            "state": "translated",
            "value": "Page title: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面标题：%@"
          }
        }
      }
    },
    "页面脚本报错，没读到正文：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page script errored, so no text was read: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面脚本报错，没读到正文：%@"
          }
        }
      }
    },
    "项目主页": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Project page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目主页"
          }
        }
      }
    },
    "（地址无效）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(invalid address)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（地址无效）"
          }
        }
      }
    },
    "（当时读到正文 %lld 字，此处不再重复）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " (%lld characters of page text were read then; not repeated here)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（当时读到正文 %lld 字，此处不再重复）"
          }
