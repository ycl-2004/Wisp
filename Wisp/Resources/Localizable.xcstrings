{
  "sourceLanguage": "zh-Hans",
  "version": "1.0",
  "strings": {
    "\n\n[…… 中间省略 %lld 字 ……]\n\n": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n[…… %lld characters omitted from the middle ……]\n\n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n[…… 中间省略 %lld 字 ……]\n\n"
          }
        }
      }
    },
    "\n\n[服务端错误] %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n[server error] %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n[服务端错误] %@"
          }
        }
      }
    },
    "\n开法：切到该配置文件的窗口，菜单栏「View → Developer → Allow JavaScript from Apple Events」。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nTo enable it: switch to a window of that profile, then choose View → Developer → Allow JavaScript from Apple Events."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n开法：切到该配置文件的窗口，菜单栏「View → Developer → Allow JavaScript from Apple Events」。"
          }
        }
      }
    },
    "\n服务端说明：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nServer said: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n服务端说明：%@"
          }
        }
      }
    },
    "%@ 没有开启「Allow JavaScript from Apple Events」，本次只读到网址，没有整页文字。在 %@ 的「View → Developer」里打开一次即可。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ does not have “Allow JavaScript from Apple Events” enabled, so only the URL was read, not the page text. Enable it once under View → Developer in %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 没有开启「Allow JavaScript from Apple Events」，本次只读到网址，没有整页文字。在 %2$@ 的「View → Developer」里打开一次即可。"
          }
        }
      }
    },
    "%lld 轮 · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld turns · %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 轮 · %2$@"
          }
        }
      }
    },
    "%lld/%lld 个对话": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld conversations"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld 个对话"
          }
        }
      }
    },
    "%@  · 可读图": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  · vision"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  · 可读图"
          }
        }
      }
    },
    "%@ 不是支持的浏览器，读不到整页文字，只能靠截图。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not a supported browser, so no page text could be read — the screenshot is all there is."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不是支持的浏览器，读不到整页文字，只能靠截图。"
          }
        }
      }
    },
    "%@ 当前没有可读取的分页窗口。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has no readable tab window right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 当前没有可读取的分页窗口。"
          }
        }
      }
    },
    "%@ 没有在限定时间内回应，本次没有读到页面文字。页面可能正忙。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ did not respond in time, so no page text was read. The page may be busy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有在限定时间内回应，本次没有读到页面文字。页面可能正忙。"
          }
        }
      }
    },
    "%@ 没有开启「Allow JavaScript from Apple Events」，本次只读到网址，没有整页文字。Safari 在「Develop」菜单里打开一次即可。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ does not have “Allow JavaScript from Apple Events” enabled, so only the URL was read, not the page text. In Safari, enable it once from the Develop menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有开启「Allow JavaScript from Apple Events」，本次只读到网址，没有整页文字。Safari 在「Develop」菜单里打开一次即可。"
          }
        }
      }
    },
    "%lld 分钟前": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld minutes ago"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 分钟前"
          }
        }
      }
    },
    "%lld 秒前": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld seconds ago"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 秒前"
          }
        }
      }
    },
    "</屏幕上下文>": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "</screen context>"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "</屏幕上下文>"
          }
        }
      }
    },
    "<屏幕上下文>": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<screen context>"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<屏幕上下文>"
          }
        }
      }
    },
    "API Key 被拒绝（401）。请检查 Key 是否正确、是否有该模型的权限。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API key rejected (401). Check that the key is correct and has access to this model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key 被拒绝（401）。请检查 Key 是否正确、是否有该模型的权限。"
          }
        }
      }
    },
    "Base URL 格式不对": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Malformed Base URL"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Base URL 格式不对"
          }
        }
      }
    },
    "Base URL 格式不对，请填写形如 https://api.openai.com/v1 的地址。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Base URL is malformed. Use an address like https://api.openai.com/v1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Base URL 格式不对，请填写形如 https://api.openai.com/v1 的地址。"
          }
        }
      }
    },
    "Codex 默认": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex default"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 默认"
          }
        }
      }
    },
    "GitHub 返回 HTTP %lld。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub returned HTTP %lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 返回 HTTP %lld。"
          }
        }
      }
    },
    "Inkling（免费备用）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkling (free fallback)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkling（免费备用）"
          }
        }
      }
    },
    "JPEG 编码失败": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JPEG encoding failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "JPEG 编码失败"
          }
        }
      }
    },
    "MiniMax M3（免费）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MiniMax M3 (free)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MiniMax M3（免费）"
          }
        }
      }
    },
    "Ollama 在运行，可读图的模型：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama is running. Vision-capable models: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama 在运行，可读图的模型：%@"
          }
        }
      }
    },
    "Ollama 在运行，装了 %lld 个模型，但没找到能读图的。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama is running with %lld models installed, but none of them can read images."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama 在运行，装了 %lld 个模型，但没找到能读图的。"
          }
        }
      }
    },
    "Ollama 本地": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama (local)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama 本地"
          }
        }
      }
    },
    "Ollama 没在运行": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama is not running"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama 没在运行"
          }
        }
      }
    },
    "Ollama 没在运行。在设置里点「启动 Ollama」，或在终端跑 `ollama serve`。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama is not running. Click “Start Ollama” in Settings, or run `ollama serve` in a terminal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama 没在运行。在设置里点「启动 Ollama」，或在终端跑 `ollama serve`。"
          }
        }
      }
    },
    "Ollama（未选模型）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama (no model selected)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama（未选模型）"
          }
        }
      }
    },
    "TLS 握手失败。如果是自建网关，检查它的证书。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS handshake failed. If this is a self-hosted gateway, check its certificate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS 握手失败。如果是自建网关，检查它的证书。"
          }
        }
      }
    },
    "Wisp 需要控制浏览器，以读取当前页面的网址与完整正文，作为提问的上下文。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wisp controls your browser to read the current page's URL and full text as context for your question."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Wisp 需要控制浏览器，以读取当前页面的网址与完整正文，作为提问的上下文。"
          }
        }
      }
    },
    "[较早一轮的屏幕上下文，已折叠] %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[Screen context from an earlier turn, collapsed] %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "[较早一轮的屏幕上下文，已折叠] %@"
          }
        }
      }
    },
    "`codex --version` 返回 %d": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`codex --version` returned %d"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`codex --version` 返回 %d"
          }
        }
      }
    },
    "codex 可以运行，配置已保存。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "codex runs. Settings saved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "codex 可以运行，配置已保存。"
          }
        }
      }
    },
    "codex 执行失败（退出码 %d）：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "codex failed (exit code %1$d): %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "codex 执行失败（退出码 %1$d）：%2$@"
          }
        }
      }
    },
    "codex 超过 %lld 秒没有返回，已经把它停掉了。可以换个更小的模型，或者先在终端直接跑一次 codex 确认它是通的。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "codex returned nothing for %lld seconds and was stopped. Try a smaller model, or run codex directly in a terminal first to confirm it works."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "codex 超过 %lld 秒没有返回，已经把它停掉了。可以换个更小的模型，或者先在终端直接跑一次 codex 确认它是通的。"
          }
        }
      }
    },
    "、": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ", "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "、"
          }
        }
      }
    },
    "「%@」在排除列表中，本次不读取截图与页面文字。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is on the exclusion list, so no screenshot or page text was read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」在排除列表中，本次不读取截图与页面文字。"
          }
        }
      }
    },
    "「%@」是最久没更新的那个，它会被永久删除，无法撤销。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is the least recently updated one. It will be permanently deleted and cannot be recovered."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」是最久没更新的那个，它会被永久删除，无法撤销。"
          }
        }
      }
    },
    "「%@」的全部消息会从本机删除，无法撤销，也没有回收站。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every message in “%@” will be deleted from this Mac. There is no undo and no trash."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」的全部消息会从本机删除，无法撤销，也没有回收站。"
          }
        }
      }
    },
    "【上一轮你的回答】\n": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[Your previous answer]\n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "【上一轮你的回答】\n"
          }
        }
      }
    },
    "【用户】\n": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[User]\n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "【用户】\n"
          }
        }
      }
    },
    "上下文": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Context"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文"
          }
        }
      }
    },
    "上次的对话记录读不出来了，已经原样备份成 %@，当前列表是空的。备份文件在 Wisp 的应用支持目录里，没有被删除。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous conversation file could not be read. It was backed up unchanged as %@ and the list is now empty. The backup is still in Wisp's application-support folder — nothing was deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次的对话记录读不出来了，已经原样备份成 %@，当前列表是空的。备份文件在 Wisp 的应用支持目录里，没有被删除。"
          }
        }
      }
    },
    "上限": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limits"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上限"
          }
        }
      }
    },
    "不花钱 · 100 万上下文 · 免费里最强，但也最容易被占满。付费版 $1.000/百万": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free · 1M context · the strongest free option, and the one most often saturated. Paid tier is $1.000 per million"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不花钱 · 100 万上下文 · 免费里最强，但也最容易被占满。付费版 $1.000/百万"
          }
        }
      }
    },
    "不花钱 · 100 万上下文 · 免费首选。付费版 $0.300/百万，说明底子不弱": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free · 1M context · the free pick. Its paid tier runs $0.300 per million, which says something about the model underneath"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不花钱 · 100 万上下文 · 免费首选。付费版 $0.300/百万，说明底子不弱"
          }
        }
      }
    },
    "不选的话就跟随系统语言。这个设置只影响 Wisp 自己，不动系统设置。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left alone, Wisp follows your system language. This setting affects Wisp only and changes nothing system-wide."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不选的话就跟随系统语言。这个设置只影响 Wisp 自己，不动系统设置。"
          }
        }
      }
    },
    "云端接口": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud endpoint"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端接口"
          }
        }
      }
    },
    "仅截图": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshot only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅截图"
          }
        }
      }
    },
    "任何 OpenAI 兼容接口，自带 Key": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any OpenAI-compatible endpoint, your own key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何 OpenAI 兼容接口，自带 Key"
          }
        }
      }
    },
    "会删除对话文件、调试文件和钥匙串里的 Key。系统的 Time Machine 备份和模型供应商那边的请求日志不在本应用控制范围内。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes the conversation file, the debug files, and the key in your Keychain. Time Machine backups and your model provider's request logs are outside Wisp's control."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会删除对话文件、调试文件和钥匙串里的 Key。系统的 Time Machine 备份和模型供应商那边的请求日志不在本应用控制范围内。"
          }
        }
      }
    },
    "位置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Position"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置"
          }
        }
      }
    },
    "你": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你"
          }
        }
      }
    },
    "你去看别的窗口以后才开始倒计时。面板有焦点、鼠标停在上面、或者回答正在生成，都不会收起。收起只是把面板收回小药丸，对话不会丢。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The countdown only starts once you look at another window. It never collapses while the panel has focus, your pointer is over it, or an answer is streaming. Collapsing just tucks the panel back into the island — no conversation is lost."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你去看别的窗口以后才开始倒计时。面板有焦点、鼠标停在上面、或者回答正在生成，都不会收起。收起只是把面板收回小药丸，对话不会丢。"
          }
        }
      }
    },
    "便宜，40 万上下文": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheap, 400K context"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "便宜，40 万上下文"
          }
        }
      }
    },
    "保存并测试连接": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save and test connection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存并测试连接"
          }
        }
      }
    },
    "信息": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Info"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信息"
          }
        }
      }
    },
    "只发当前窗口截图和网址。不读页面，最快。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends the current window and URL only. Fastest."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只发当前窗口截图和网址。不读页面，最快。"
          }
        }
      }
    },
    "读取页面正文。动态页面可能只包含当前可见内容。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads page text. Dynamic pages may include visible content only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取页面正文。动态页面可能只包含当前可见内容。"
          }
        }
      }
    },
    "滚动动态页面后回到原位。需要辅助功能权限。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrolls dynamic pages, then returns to your position. Requires Accessibility."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动动态页面后回到原位。需要辅助功能权限。"
          }
        }
      }
    },
    "本机运行、无需联网；请选择支持图片输入的模型。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs locally with no network; choose a model that accepts images."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机运行、无需联网；请选择支持图片输入的模型。"
          }
        }
      }
    },
    "使用已登录的 Codex，无需 API Key；回答一次性返回。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses your signed-in Codex; no API Key needed, and replies arrive at once."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用已登录的 Codex，无需 API Key；回答一次性返回。"
          }
        }
      }
    },
    "Codex 测试只检查能否启动。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Codex test only checks startup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 测试只检查能否启动。"
          }
        }
      }
    },
    "发送一张 64×64 测试图，验证连接和图片输入。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends a 64×64 test image to verify the connection and image input."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送一张 64×64 测试图，验证连接和图片输入。"
          }
        }
      }
    },
    "底部位置可拖动，Wisp 会记住位置；面板仍从底部中央打开。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the desktop island; Wisp remembers its position. The panel still opens from bottom center."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "底部位置可拖动，Wisp 会记住位置；面板仍从底部中央打开。"
          }
        }
      }
    },
    "空闲时只显示图标；悬停展开，点击打开。回答生成时可停止。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Idle shows an icon; hover to expand and click to open. Stop while generating."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空闲时只显示图标；悬停展开，点击打开。回答生成时可停止。"
          }
        }
      }
    },
    "离开面板后开始倒计时；输入、悬停、生成或采集时不会收起。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts after leaving the panel; stays open while focused, hovered, generating, or capturing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开面板后开始倒计时；输入、悬停、生成或采集时不会收起。"
          }
        }
      }
    },
    "整页文字需要浏览器的 Apple Events 权限；在浏览器的 Developer 菜单中开启。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-page text requires browser Apple Events access. Enable it from the browser's Developer menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整页文字需要浏览器的 Apple Events 权限；在浏览器的 Developer 菜单中开启。"
          }
        }
      }
    },
    "每个 Chromium 配置文件都要单独开启；未开启时仍可读网址和截图。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable it once per Chromium profile. Without it, Wisp still reads the URL and screenshot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个 Chromium 配置文件都要单独开启；未开启时仍可读网址和截图。"
          }
        }
      }
    },
    "需要辅助功能权限才能滑动采集。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility permission is required for scroll collection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要辅助功能权限才能滑动采集。"
          }
        }
      }
    },
    "超出上限时保留开头和结尾，并标记省略。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over the limit, Wisp keeps the beginning and end and marks the omission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超出上限时保留开头和结尾，并标记省略。"
          }
        }
      }
    },
    "排除后不截图，也不读取浏览器页面。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluded apps are not captured or read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排除后不截图，也不读取浏览器页面。"
          }
        }
      }
    },
    "到上限时，新建对话会询问是否移除最久未更新的一项。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the limit, creating a conversation asks before removing the least recently updated one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到上限时，新建对话会询问是否移除最久未更新的一项。"
          }
        }
      }
    },
    "只保存对话和页面文字快照；截图不会写入磁盘。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only conversations and page-text snapshots are stored; screenshots never touch disk."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只保存对话和页面文字快照；截图不会写入磁盘。"
          }
        }
      }
    },
    "额外写入 last-context.json 和 last-screenshot.jpg，仅用于排查。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writes last-context.json and last-screenshot.jpg for diagnostics only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "额外写入 last-context.json 和 last-screenshot.jpg，仅用于排查。"
          }
        }
      }
    },
    "删除对话、调试文件和钥匙串中的 API Key；不可撤销。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes conversations, debug files, and the API Key in Keychain. This cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除对话、调试文件和钥匙串中的 API Key；不可撤销。"
          }
        }
      }
    },
    "留空跟随系统；只影响 Wisp，不改系统语言。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave it as system; this affects Wisp only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空跟随系统；只影响 Wisp，不改系统语言。"
          }
        }
      }
    },
    "仅请求 GitHub 的版本号，不发送使用信息，也不会自动下载。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks only GitHub for the version number; sends no usage info and never downloads automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅请求 GitHub 的版本号，不发送使用信息，也不会自动下载。"
          }
        }
      }
    },
    "崩溃日志由 macOS 控制台保存；Wisp 不包含统计或崩溃上报。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS Console stores crash logs; Wisp includes no analytics or crash reporting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "崩溃日志由 macOS 控制台保存；Wisp 不包含统计或崩溃上报。"
          }
        }
      }
    },
    "停止": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止"
          }
        }
      }
    },
