    },
    "还没有历史对话。直接在下方提问就会自动建立。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No conversations yet. Ask something below and one gets created."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有历史对话。直接在下方提问就会自动建立。"
