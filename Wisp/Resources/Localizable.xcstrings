    },
    "请求发送到 %@。API Key 按服务商分开保存在 macOS 钥匙串。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests go to %@. API keys are stored per provider in the macOS Keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求发送到 %@。API Key 按服务商分开保存在 macOS 钥匙串。"
