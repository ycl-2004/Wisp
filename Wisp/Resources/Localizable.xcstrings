        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅请求 GitHub 的版本号，不发送使用信息，也不会自动下载。"
          }
        }
      }
    },
    "崩溃日志由 macOS 控制台保存；Wisp 不包含统计或崩溃上报。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
