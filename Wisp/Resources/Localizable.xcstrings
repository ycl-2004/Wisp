          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部删除"
          }
        }
      }
    },
    "关于": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "减少": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decrease"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减少"
          }
        }
      }
    },
    "切换接法和模型：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch provider and model: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换接法和模型：%@"
          }
        }
      }
    },
    "刚改完设置的话，Chrome 可能还没写盘，这行会慢一拍。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " If you just changed the setting, Chrome may not have written it to disk yet, so this line can lag behind."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刚改完设置的话，Chrome 可能还没写盘，这行会慢一拍。"
          }
        }
      }
    },
    "刚读取": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "just now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刚读取"
          }
        }
      }
    },
    "删掉「%@」并新建": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete “%@” and start a new one"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删掉「%@」并新建"
          }
        }
      }
    },
    "删掉最旧的并新建": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the oldest and start a new one"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删掉最旧的并新建"
          }
        }
      }
    },
    "删除": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        }
      }
    },
    "删除全部对话与 API Key": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all conversations and the API key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除全部对话与 API Key"
          }
        }
      }
    },
    "删除全部数据？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all data?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除全部数据？"
          }
        }
      }
    },
    "到上限不会自动删旧的。新建时会问你要不要顶掉最久没更新的那个，确认后才删。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is deleted automatically at the limit. When you start a new conversation Wisp asks whether to drop the least recently updated one, and only deletes after you confirm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到上限不会自动删旧的。新建时会问你要不要顶掉最久没更新的那个，确认后才删。"
          }
        }
      }
