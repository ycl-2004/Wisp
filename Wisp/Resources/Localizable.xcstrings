        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新检测"
          }
        }
      }
    },
    "重新读取当前屏幕（%@）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-read the current screen (%@)"
