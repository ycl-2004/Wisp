{
  "sourceLanguage": "zh-Hans",
  "version": "1.0",
  "strings": {
    "支持图片输入，优先请求 Fast。模型标价为标准费率，加速按更高费率计费。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supports images and prefers Fast. Listed model prices are standard rates; Fast is billed at a higher rate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持图片输入，优先请求 Fast。模型标价为标准费率，加速按更高费率计费。"
          }
        }
      }
    },
    "优先请求 Priority 加速，可能产生更高费用。可用性取决于模型和账户。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests prefer Priority processing, which may cost more. Availability depends on the model and account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先请求 Priority 加速，可能产生更高费用。可用性取决于模型和账户。"
          }
        }
      }
    },
    "付费模型优先 Fast，免费模型优先速度。模型标价为标准费率，加速可能更贵。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paid models prefer Fast; free models prefer faster providers. Listed model prices are standard rates; Fast may cost more."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付费模型优先 Fast，免费模型优先速度。模型标价为标准费率，加速可能更贵。"
          }
        }
      }
    },
    "滚动采集": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll Capture"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动采集"
          }
        }
      }
    },
    "刷新 Agy 模型": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh Agy Models"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新 Agy 模型"
          }
        }
      }
    },
    "刷新本机模型": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh Local Models"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新本机模型"
          }
        }
      }
    },
    "没有排除的应用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No excluded apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有排除的应用"
          }
        }
      }
    },
    "对话和页面文字保存在本机。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversations and page text are saved on this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话和页面文字保存在本机。"
          }
        }
      }
    },
    "备份并重置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back Up & Reset"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份并重置"
          }
        }
      }
    },
    "需要设置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup Required"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要设置"
          }
        }
      }
    },
    "管理…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理…"
          }
        }
      }
    },
    "在系统设置中管理 Wisp 的登录权限。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage Wisp’s login permissions in System Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置中管理 Wisp 的登录权限。"
          }
        }
      }
    },
    "登录项": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Login Items"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录项"
          }
        }
      }
    },
    "不附带截图": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclude Screenshot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不附带截图"
          }
        }
      }
    },
    "刷新上下文": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh Context"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新上下文"
          }
        }
      }
    },
    "采集详情": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Details"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采集详情"
          }
        }
      }
    },
    "附带截图": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include Screenshot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附带截图"
          }
        }
      }
    },
    "设置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        }
      }
    },
    "已达上限，可移除最早的对话后新建": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversation limit reached. Remove the oldest conversation to create one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达上限，可移除最早的对话后新建"
          }
        }
      }
    },
    "仅检查本地工具能否启动，不消耗模型额度。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that the local tool can start, without using model credits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅检查本地工具能否启动，不消耗模型额度。"
          }
        }
      }
    },
    "从 Agy 获取最新可用模型。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetch available models from Agy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 Agy 获取最新可用模型。"
          }
        }
      }
    },
    "使用 Claude Code 登录。截图临时保存，用后删除。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your Claude Code login. Screenshots are stored temporarily and deleted after use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Claude Code 登录。截图临时保存，用后删除。"
          }
        }
      }
    },
    "使用 Agy 登录。截图临时保存，用后删除。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your Agy login. Screenshots are stored temporarily and deleted after use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Agy 登录。截图临时保存，用后删除。"
          }
        }
      }
    },
    "使用 Codex 登录，回答实时显示。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your Codex login. Responses appear as they arrive."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Codex 登录，回答实时显示。"
          }
        }
      }
    },
    "保存诊断文件": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Diagnostics"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存诊断文件"
          }
        }
      }
    },
    "刷新模型": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh Models"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新模型"
          }
        }
      }
    },
    "保存并测试": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save & Test"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存并测试"
          }
        }
      }
    },
    "立即重启": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart Now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即重启"
          }
        }
      }
    },
    "登录时启动": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch at Login"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时启动"
          }
        }
      }
    },
    "自动检查更新": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for Updates at Launch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动检查更新"
          }
        }
      }
    },
    "浏览器自动化": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser Automation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器自动化"
          }
        }
      }
    },
    "重置位置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset Position"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置位置"
          }
        }
      }
    },
    "排除当前应用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclude Current App"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排除当前应用"
          }
        }
      }
    },
    "共享时隐藏": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide from Capture"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享时隐藏"
          }
        }
      }
    },
    "菜单栏图标可能出现在共享和录屏中。关闭后，仍可用全局快捷键打开 Wisp，再通过面板上的齿轮进入设置。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The menu bar icon may appear in shared screens and recordings. When hidden, use your global shortcut to open Wisp, then the gear button to access Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏图标可能出现在共享和录屏中。关闭后，仍可用全局快捷键打开 Wisp，再通过面板上的齿轮进入设置。"
          }
        }
      }
    },
    "在兼容的共享和录屏中隐藏 Wisp，本机仍可正常使用。效果因系统和录屏工具而异，请检查接收端画面。录制 Wisp 演示时请关闭。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide Wisp in compatible sharing and recording tools while keeping it visible to you. Results vary by macOS version and recording tool; check the receiving screen. Turn off to record a Wisp demo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在兼容的共享和录屏中隐藏 Wisp，本机仍可正常使用。效果因系统和录屏工具而异，请检查接收端画面。录制 Wisp 演示时请关闭。"
          }
        }
      }
    },
    "在共享和录屏中隐藏 Wisp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide Wisp from Sharing/Recording"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在共享和录屏中隐藏 Wisp"
          }
        }
      }
    },
    "\n\n[…… 中间省略 %lld 字 ……]\n\n": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n[…… %lld characters omitted from the middle ……]\n\n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n[…… 中间省略 %lld 字 ……]\n\n"
          }
        }
      }
    },
    "\n\n[服务端错误] %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n[server error] %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n[服务端错误] %@"
          }
        }
      }
    },
    "\n开法：切到该配置文件的窗口，菜单栏「View → Developer → Allow JavaScript from Apple Events」。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nTo enable it: switch to a window of that profile, then choose View → Developer → Allow JavaScript from Apple Events."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n开法：切到该配置文件的窗口，菜单栏「View → Developer → Allow JavaScript from Apple Events」。"
          }
        }
      }
    },
    "\n服务端说明：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nServer said: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n服务端说明：%@"
          }
        }
      }
    },
    "%@ 没有开启「Allow JavaScript from Apple Events」，本次只读到网址，没有整页文字。在 %@ 的「View → Developer」里打开一次即可。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ does not have “Allow JavaScript from Apple Events” enabled, so only the URL was read, not the page text. Enable it once under View → Developer in %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 没有开启「Allow JavaScript from Apple Events」，本次只读到网址，没有整页文字。在 %2$@ 的「View → Developer」里打开一次即可。"
          }
        }
      }
    },
    "%lld 轮 · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld turns · %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 轮 · %2$@"
          }
        }
      }
    },
    "%lld/%lld 个对话": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld conversations"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld 个对话"
          }
        }
      }
    },
    "%@  · 可读图": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  · vision"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  · 可读图"
          }
        }
      }
    },
    "%@ 不是支持的浏览器，读不到整页文字，只能靠截图。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not a supported browser, so no page text could be read — the screenshot is all there is."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不是支持的浏览器，读不到整页文字，只能靠截图。"
          }
        }
      }
    },
    "%@ 当前没有可读取的分页窗口。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has no readable tab window right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 当前没有可读取的分页窗口。"
          }
        }
      }
    },
    "%@ 没有在限定时间内回应，本次没有读到页面文字。页面可能正忙。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ did not respond in time, so no page text was read. The page may be busy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有在限定时间内回应，本次没有读到页面文字。页面可能正忙。"
          }
        }
      }
    },
    "%@ 没有开启「Allow JavaScript from Apple Events」，本次只读到网址，没有整页文字。Safari 在「Develop」菜单里打开一次即可。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ does not have “Allow JavaScript from Apple Events” enabled, so only the URL was read, not the page text. In Safari, enable it once from the Develop menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有开启「Allow JavaScript from Apple Events」，本次只读到网址，没有整页文字。Safari 在「Develop」菜单里打开一次即可。"
          }
        }
      }
    },
    "%lld 分钟前": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld minutes ago"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 分钟前"
          }
        }
      }
    },
    "%lld 秒前": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld seconds ago"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 秒前"
          }
        }
      }
    },
    "</屏幕上下文>": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "</screen context>"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "</屏幕上下文>"
          }
        }
      }
    },
    "<屏幕上下文>": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<screen context>"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<屏幕上下文>"
          }
        }
      }
    },
    "API Key 被拒绝（401）。请检查 Key 是否正确、是否有该模型的权限。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API key rejected (401). Check that the key is correct and has access to this model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
