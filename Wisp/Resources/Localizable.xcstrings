        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已跟到新的页面，正文还没读取。发送问题时会读取当前页面。"
          }
        }
      }
    },
    "智谱 GLM": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zhipu GLM"
          }
        },
        "zh-Hans": {
